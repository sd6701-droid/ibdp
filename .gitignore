# ---------------------------------------------------------------------------
# PHI GUARD — nothing under these paths may ever reach git.
# This project handles patient data on BigPurple. Keep it on the cluster.
# ---------------------------------------------------------------------------
data/
inputs/
outputs/
results/
runs/
*.dcm
*.nii
*.nii.gz
*.mp4
*.avi
*.mov
*.mkv
*.pdf
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.csv
*.tsv
*.xlsx
*.parquet
*.jsonl

# Scraped dataset. On the cluster this tree lives INSIDE the checkout
# (/gpfs/scratch/$USER/personal/ibdp/youtube_dataset), so a bare `git add .`
# would otherwise stage a few hundred sidecar files per download run.
youtube_dataset/
# yt-dlp sidecars: metadata, subtitles, in-flight parts, resume/reconcile logs
*.info.json
*.vtt
*.srt
*.part
downloaded.txt
missing.txt

# Chambers et al. labelled YouTube dataset (scripts/39). On the cluster the
# downloaded videos land INSIDE the checkout, so ignore the tree by default and
# re-include ONLY the URL list. That CSV is public YouTube urls + label windows
# from the published release -- no PHI, and it is the input the script needs, so
# it is the one file here that belongs in git.
# Order matters: `datasets/*` (not `datasets/`) leaves the directory itself
# un-excluded, which is what lets the negations below re-include a path under it.
datasets/*
!datasets/chambers_infant_youtube/
datasets/chambers_infant_youtube/*
!datasets/chambers_infant_youtube/URL_labelled_dataset.csv
# The same URL list at the checkout root, which is where it lands on the
# cluster. Leading slash anchors this to the repo root, so it re-includes only
# that one file and not any other URL_labelled_dataset.csv deeper in the tree.
!/URL_labelled_dataset.csv

# ViTPose overlay clips + keypoint JSON pulled from the cluster
pose_videos/

# Local scene-split test output (scripts/32) -- clips, wavs, thumbs, meta
test_data_splits/

# Probe/sample bundles from scripts/33 & 34, when copied to the repo root for
# a look. Model outputs, not code; the canonical copies live in outputs/ on
# gpfs (and in W&B once logged).
probe_*_all_models.json
sample_*_all_models.json

# Explicit opt-in for synthetic / example assets only
!examples/assets/**
!docs/**/*.png

# Models & caches (huge, live on /gpfs, never in git)
models/
.cache/
hf_cache/
# HF_HOME set by the fetch/serve scripts -- tens of GB
.hf/
*.safetensors
*.gguf
*.bin
*.pt
*.pth

# SLURM
slurm-*.out
logs/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
dist/
build/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

Chamber-etal-dataset/
# Secrets
.env.local
*.key
*.pem
secrets.yaml
# Exported YouTube cookies are live session credentials for a Google account --
# anyone with the file is signed in as you. gitpush.sh runs `git add .`, so
# these must be ignored by name rather than by remembering not to stage them.
cookies*.txt
*cookies.txt

# Chambers et al. released source bundle (repo zips, pose CSVs, PDFs) --
# reference material we read, not code we maintain.
chamber_et_al_src/
