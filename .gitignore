# ---------------------------------------------------------------------------
# PHI GUARD — nothing under these paths may ever reach git.
# This project handles patient data on BigPurple. Keep it on the cluster.
# ---------------------------------------------------------------------------
data/
inputs/
outputs/
results/
runs/
*.dcm
*.nii
*.nii.gz
*.mp4
*.avi
*.mov
*.mkv
*.pdf
*.png
*.jpg
*.jpeg
*.tif
*.tiff
*.csv
*.tsv
*.xlsx
*.parquet
*.jsonl

# Scraped dataset. On the cluster this tree lives INSIDE the checkout
# (/gpfs/scratch/$USER/personal/ibdp/youtube_dataset), so a bare `git add .`
# would otherwise stage a few hundred sidecar files per download run.
youtube_dataset/
# yt-dlp sidecars: metadata, subtitles, in-flight parts, resume/reconcile logs
*.info.json
*.vtt
*.srt
*.part
downloaded.txt
missing.txt

# ViTPose overlay clips + keypoint JSON pulled from the cluster
pose_videos/

# Local scene-split test output (scripts/32) -- clips, wavs, thumbs, meta
test_data_splits/

# Probe/sample bundles from scripts/33 & 34, when copied to the repo root for
# a look. Model outputs, not code; the canonical copies live in outputs/ on
# gpfs (and in W&B once logged).
probe_*_all_models.json
sample_*_all_models.json

# Explicit opt-in for synthetic / example assets only
!examples/assets/**
!docs/**/*.png

# Models & caches (huge, live on /gpfs, never in git)
models/
.cache/
hf_cache/
# HF_HOME set by the fetch/serve scripts -- tens of GB
.hf/
*.safetensors
*.gguf
*.bin
*.pt
*.pth

# SLURM
slurm-*.out
logs/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
*.egg-info/
dist/
build/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/

# Secrets
.env.local
*.key
*.pem
secrets.yaml
